# Production environment for ETABLIX — copy to /etc/etablix.env, fill in,
# then: chmod 600 /etc/etablix.env && chown root:root /etc/etablix.env

NODE_ENV=production
PORT=3000

# REQUIRED — any long random string; keeps employee sessions valid across
# restarts. Generate with: openssl rand -hex 32
ETABLIX_TOKEN_SECRET=

# REQUIRED — your real Control Desk administrator. When these are set, the
# demo accounts are never created and the login page shows no demo hint.
ETABLIX_ADMIN_EMAIL=
ETABLIX_ADMIN_PASSWORD=
ETABLIX_ADMIN_NAME=Justin Nseya

# Email notifications for enquiries and supplier registrations.
# Until these are set, notifications queue in backend/data/outbox.log and
# everything is always visible in the Control Desk.
# SMTP_USER and the address inside NOTIFY_FROM MUST be the same mailbox, and
# that mailbox must be on the domain SPF authorises. If they differ, SPF and
# DKIM will not align and receiving mailboxes treat the message as a forgery —
# which is how a website enquiry ends up in the junk box. The server warns
# about this at boot. See deploy/EMAIL-DELIVERABILITY.md, and check the domain
# any time with:  node tools/mail-doctor.mjs etablix.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@etablix.com
SMTP_PASS=
NOTIFY_TO=contact@etablix.com
NOTIFY_FROM=ETABLIX Website <no-reply@etablix.com>

# Public site URL — used in supplier-facing links (PQQ, portal, enquiries).
SITE_URL=https://etablix.com

# WATCHING — the only thing on this list that survives the box dying.
# Create a free check at any heartbeat monitor (healthchecks.io, Better Stack,
# Cronitor) with a period of 5 minutes and a grace of 10, and paste its URL
# here. The application pings it every two minutes; if the container, the disk
# or the machine dies, the pings stop and the monitor tells you. Nothing
# running on this box can tell you this box has stopped.
HEARTBEAT_URL=

# Alerts that do not depend on email — because email is the thing most likely
# to be broken when there is something to report. Any Slack/Teams webhook.
ALERT_WEBHOOK_URL=

# OPTIONAL — Companies House verification in the prequal scorecard and
# Agent 7 briefings. Free key from:
# https://developer.company-information.service.gov.uk (create an
# application, copy the REST API key). Leave empty to keep the check off.
CH_API_KEY=
