# Production environment for ETABLIX — copy to /etc/etablix.env, fill in,
# then: chmod 600 /etc/etablix.env && chown root:root /etc/etablix.env

NODE_ENV=production
PORT=3000

# REQUIRED — any long random string; keeps employee sessions valid across
# restarts. Generate with: openssl rand -hex 32
ETABLIX_TOKEN_SECRET=

# REQUIRED — your real Control Desk administrator. When these are set, the
# demo accounts are never created and the login page shows no demo hint.
ETABLIX_ADMIN_EMAIL=
ETABLIX_ADMIN_PASSWORD=
ETABLIX_ADMIN_NAME=Justin Nseya

# Email notifications for enquiries and supplier registrations.
# Until these are set, notifications queue in backend/data/outbox.log and
# everything is always visible in the Control Desk.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=contact@etablix.com
NOTIFY_FROM=ETABLIX Website <no-reply@etablix.com>
